# ── 必填 ─────────────────────────────────────────────────────────────────

# 注册访问码（用于验证注册者身份，即"本校学生验证码"）
PASSWORD="your_school_access_code"

# 会话加密密钥（建议使用 openssl rand -base64 32 生成）
SESSION_SECRET="your_very_strong_random_secret"

# Resend API Key（用于发送注册验证邮件）
# 申请地址：https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# 发件人地址（须在 Resend 中完成域名验证）
# 格式：名称 <邮箱>  或  直接写邮箱
MAIL_FROM="Hotsearch <noreply@yourdomain.com>"


# ── 可选 ─────────────────────────────────────────────────────────────────

# 服务端口（默认 3000）
# PORT=3000

# 热搜 JSON 文件路径（默认：程序根目录下的 data/hotspots.json）
# HOTSPOTS_FILE="./data/hotspots.json"

# SQLite 数据库路径（用户 & 热度记录，默认：程序根目录下的 app.db）
# DB_PATH="./app.db"

# 是否信任代理（内网穿透 / Nginx 反代时设为 true，直连时保持 false）
# TRUST_PROXY=false

# 每人每天最大加热次数（默认 3）
# MAX_HEAT_PER_DAY=3

# 冷门热搜自动清理：热度阈值（默认 3，热度低于此值才可能被清理）
# COLD_HEAT_THRESHOLD=3

# 冷门热搜自动清理：年龄阈值天数（默认 3，超过此天数且热度不足才清理）
# COLD_AGE_DAYS=3

# 你的邮件自定义签名
# SIGNATURE="your_school"


# ── 反向代理配置 ─────────────────────────────────────────────────────────────────
# 如果你使用了反向代理（如 ngrok、Nginx）让 HotSearch 对公网可见，必须配置以下两项，确保 HotSearch 正确获取客户端真实 IP。
# 两项要么同时设置，要么都不设置。如果你不确定，请不要设置。

# 1. 从哪个请求头读取真实 IP（ngrok 默认使用 X-Forwarded-For）
# TRUSTED_PROXY_HEADER="X-Forwarded-For"

# 2. 信任的反向代理 IP 地址列表（逗号分隔，支持 IPv4/IPv6）
# 注意：只信任来自这些 IP 的代理头，其他来源直接使用连接 IP
# TRUSTED_PROXY_IPS="127.0.0.1,::1,::ffff:127.0.0.1"